# Ma'lumotlar bazasi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ilm_crm
DB_USER=admin
DB_PASS=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# 2FA
TWO_FA_APP_NAME=IlmAcademyCRM

# AES-256 shifrlash kaliti (64 hex belgi = 32 bayt)
AES_SECRET_KEY=

# MinIO (yoki boshqa S3-mos saqlash)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=ilm-crm

# SMS (Eskiz.uz) — bo'sh qoldirilsa SMS yuborilmaydi
SMS_PROVIDER=eskiz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Firebase
FIREBASE_PROJECT_ID=

# Livekit (jonli efir / onlayn dars) — bo'sh qoldirilsa video xizmati "sozlanmagan" holatda ishlaydi
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# OpenAI (chat AI moderatsiya, kitob-test generatsiya) — bo'sh qoldirilsa so'zlar ro'yxatiga qaytadi
OPENAI_API_KEY=

# App
# PORT — Railway/Render kabi PaaS avtomatik beradi, qo'lda o'rnatish shart emas
APP_PORT=3000
APP_ENV=development
FRONTEND_URL=http://localhost:3001

# Brute force himoya
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_BLOCK_MINUTES=30

# To'lov avto-blok: qarzdorlik boshlanganidan necha kun o'tgach o'quvchi ilovasi qulflanadi
PAYMENT_LOCK_GRACE_DAYS=15
